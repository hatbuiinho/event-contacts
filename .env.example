# Neon pooled connection string. Keep this value private: never prefix it with PUBLIC_.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Used later for secure admin sessions. Generate a long random value for each environment.
SESSION_SECRET=replace-with-a-long-random-secret

# These values create the first admin account only when the users table is empty.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_DISPLAY_NAME=Ban quản trị
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
