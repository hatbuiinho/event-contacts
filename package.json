{
	"name": "event-contacts",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "node --test --experimental-strip-types src/lib/contacts/assignment-text-parser.test.ts src/lib/contacts/import-plan.test.ts src/lib/contacts/normalize.test.ts src/lib/volunteers/sheet-parser.test.ts src/lib/memorial/sheet-parser.test.ts src/lib/memorial/position-sheet-parser.test.ts",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"cap:sync": "yarn build && cap sync",
		"cap:android": "yarn build && cap run android",
		"ota:publish": "yarn build && node scripts/publish-ota-bundle.mjs",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.0",
		"@eslint/js": "^10.0.1",
		"@iconify/json": "^2.2.508",
		"@iconify/tailwind4": "^1.2.3",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@capacitor/android": "^8.5.0",
		"@capacitor/core": "^8.5.0",
		"@capacitor/push-notifications": "8.1.2",
		"@capgo/capacitor-updater": "^8.51.3",
		"@neondatabase/serverless": "^1.1.0",
		"@sveltejs/kit": "^2.63.0",
		"cropperjs": "^1.6.2",
		"drizzle-orm": "^0.45.2"
	}
}
